# iJudge credentials for scripts/ (scrape, sync, submit).
# Copy to .env and fill in. NEVER commit the filled-in copy.
#
# Two ways to authenticate, in order of preference:
#
# 1. Session cookie (preferred — no password on disk at all).
#    From a logged-in browser: DevTools > Network > any request > Cookie header.
#    Tokens are short-lived (~24h), so expect to refresh this.
IJUDGE_COOKIE=

# 2. Username + password, used only to mint a fresh cookie when IJUDGE_COOKIE
#    is unset or expired. The scripts refuse to run if both paths are empty.
IJUDGE_USER=
IJUDGE_PASS=

# Next.js server-action id for the sign-in endpoint. Not a secret, but it is
# pinned to a specific iJudge frontend build — override here if sign-in starts
# failing after they redeploy. Re-copy from a browser network capture.
# IJUDGE_SIGNIN_ACTION_ID=
